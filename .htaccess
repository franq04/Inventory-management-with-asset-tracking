<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Keep old /public URLs working but canonicalize to root URL.
    RewriteRule ^public/(.*)$ $1 [R=302,L]

    # Expose common static assets from /public at the app root URL.
    RewriteRule ^(build|images|storage|user-manual-images)/(.*)$ public/$1/$2 [L]

    # Serve root-level static files from /public.
    RewriteRule ^(favicon\.ico|robots\.txt)$ public/$1 [L]

    # Send all app routes to the root front controller.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
